 "resolution": {
  "title": "Working together on safe, orderly and regular migration",
  "preambular": [
   {
    "text": "Guided by the purposes and principles of the Charter of the United Nations,",
    "tags": []
   },
   {
    "text": "Recalling the Universal Declaration of Human Rights, which says that all people are born free and equal in dignity and rights,",
    "tags": []
   },
   {
    "text": "Recognising that people have always moved between countries to work, to study, to join family and to find safety,",
    "tags": []
   },
   {
    "text": "Mindful that every State has a duty to treat all people within its territory with dignity,",
    "tags": []
   }
  ],
  "operative": [
   {
    "text": "Urges States to open more regular routes for work, study and family reunion, including for workers in lower-paid jobs;",
    "tags": [
     "legal_pathways"
    ]
   },
   {
    "text": "Calls upon States to cooperate on the return and readmission of their own nationals who have no right to stay, checking each case individually and supporting people to settle back home;",
    "tags": [
     "returns"
    ]
   },
   {
    "text": "Decides that children should not be held in immigration detention and that community-based care should be used instead;",
    "tags": [
     "child_detention"
    ]
   },
   {
    "text": "Encourages States to share responsibility for large numbers of arrivals, by resettling some people and by funding the countries that host the most;",
    "tags": [
     "shared_responsibility"
    ]
   },
   {
    "text": "Requests States to plan for people who must leave home because of floods, drought and rising seas, including by offering humanitarian visas;",
    "tags": [
     "climate_displacement"
    ]
   },
   {
    "text": "Encourages States to share migration data and to align border checks and identity papers, with strong rules to protect privacy;",
    "tags": [
     "data_borders"
    ]
   },
   {
    "text": "Affirms that each State alone decides who may enter and stay in its territory, and that no international text creates a right to enter any particular country.",
    "tags": [
     "sovereignty"
    ]
   }
  ]
 },
